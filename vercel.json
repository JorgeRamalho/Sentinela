{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/main.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "backend/main.py": {
      "maxDuration": 60,
      "includeFiles": "data/logs/**"
    }
  },
  "env": {
    "SIMULATE": "true",
    "CONFIRM_EXECUTE": "false",
    "DATABASE_URL": "sqlite:////tmp/sentinela.db",
    "APP_ENV": "production"
  }
}
