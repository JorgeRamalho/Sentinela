# Sentinela — copie para .env e ajuste. SIMULATE=true é o modo seguro para entrevista/demo.
APP_NAME=Sentinela
APP_ENV=demo
SIMULATE=true
CONFIRM_EXECUTE=false
DATABASE_URL=sqlite:///./sentinela.db
LOG_SCAN_PATH=../data/logs
EXPORT_PATH=../data/exports

# Alertas (só enviados se SIMULATE=false e o endpoint estiver preenchido)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# Relatório semanal (SMTP opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=sustentacao@empresa.local

# Service Desk — se vazio, usa conectores simulados com dados realistas
TICKET_SOURCE=glpi
JIRA_URL=
JIRA_USER=
JIRA_TOKEN=
GLPI_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
SERVICENOW_URL=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_TOKEN=
